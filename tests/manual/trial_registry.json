{
  "metadata": {
    "title": "Aegis V4 Scientific Validation — Pre-Registered Trial Registry",
    "version": "1.0.0",
    "created": "2026-08-03T00:00:00Z",
    "hypothesis": "Aegis reduces token consumption on non-compliant coding tasks by preventing invalid code generation before it starts",
    "null_hypothesis": "Aegis provides no statistically significant difference in token consumption compared to running without Aegis",
    "alpha": 0.05,
    "power_target": 0.80,
    "minimum_effect_size_cohens_d": 0.8,
    "acceptance_criteria": [
      "p < 0.05 on one-tailed paired t-test for primary metric (token consumption)",
      "Cohen's d > 0.8 (large effect size)",
      "Mean token savings > 25% on non-compliant tasks (practical significance)",
      "Code quality score improvement >= 2 points on 35-point scale",
      "Standard deviation of savings < 30% of mean savings (consistency)",
      "At least 6 of 7 'with Aegis' trials show improvement over median 'without Aegis'"
    ],
    "rejection_criteria": [
      "Agent crashes, network failure, or MCP server startup failure",
      "Human error in prompt entry (wrong prompt, wrong agent)",
      "Maximum 1 rejection per condition allowed"
    ]
  },
  "stages": [
